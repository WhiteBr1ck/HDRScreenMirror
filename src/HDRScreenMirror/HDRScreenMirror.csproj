<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>HDRScreenMirror</AssemblyName>
    <RootNamespace>HDRScreenMirror</RootNamespace>
    <ApplicationIcon>Assets\HDRScreenMirror.ico</ApplicationIcon>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0</AssemblyVersion>
    <FileVersion>1.5.0</FileVersion>
    <InformationalVersion>1.5.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo-hdrscreenmirror.png" />
    <Content Include="Shaders\MirrorVS.cso" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\MirrorPS.cso" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\LuminanceCS.cso" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\PointerProbeCS.cso" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\GamutClearCS.cso" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\GamutAnalysisCS.cso" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\CursorVS.cso" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\CursorPS.cso" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
